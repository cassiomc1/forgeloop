{
  "name": "@cassiomc1/forgeloop",
  "version": "1.12.0",
  "description": "Portable, verifiable engineering protocol for AI coding environments and developer workflows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cassiomc1/forgeloop.git"
  },
  "homepage": "https://github.com/cassiomc1/forgeloop#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "forgeloop": "src/cli.js"
  },
  "files": [
    "src",
    "ENG",
    "schemas",
    "benchmarks/execution-profiles/*.json",
    "benchmarks/execution-profiles/README.md",
    "benchmarks/repository-index/queries.json",
    "benchmarks/repository-index/README.md",
    "benchmarks/repository-index/run-hot-path.mjs",
    "benchmarks/repository-index/run-persistent-transport.mjs",
    ".forgeloop/forgeloop.gitignore",
    "AGENTS.md",
    "CLAUDE.md",
    "GUIDE_ROUTER.md",
    "LOOP_ENGINEERING.md",
    "PROTOCOL_INTEGRATION.md",
    "AGENT_COMPATIBILITY.md",
    "LOOP_SYSTEM_DESIGN.md",
    "QUALITY_SCORECARD.md",
    "TERMINOLOGY.md",
    "EXECUTION_STATE.md",
    "DELEGATION_PROTOCOL.md",
    "ORCHESTRATOR_INTEGRATION.md",
    "THREAT_MODEL.md",
    "CONTRACT_COVERAGE.md",
    "PROJECT_PROFILE.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "LICENSE-DOCS.md",
    ".cursor",
    ".github/copilot-instructions.md",
    "README.md",
    "DOCS_INDEX.md",
    "docs/diagrams",
    "docs/assets/diagrams",
    "docs/GETTING_STARTED.md",
    "docs/CROSS_HARNESS_CONTINUITY.md",
    "docs/ADVISORY_CONTEXT.md",
    "docs/RIPWIRE_ADAPTER.md",
    "docs/CLI_REFERENCE.md",
    "docs/ARTIFACT_REFERENCE.md",
    "docs/TROUBLESHOOTING.md",
    "docs/RECIPES.md",
    "docs/STRUCTURAL_QUALITY.md",
    "docs/DOCUMENTATION_GUIDE.md",
    "docs/RELEASE_CHECKLIST.md",
    "docs/PACKAGE_CONTENTS.md",
    "scripts/CI_VALIDATORS.md",
    "docs/MCP.md",
    "docs/UNIVERSAL_INTEGRATION.md",
    "docs/DIAGNOSTIC_MODEL.md",
    "docs/EXECUTION_TRACE.md",
    "docs/CODE_ATTESTATION.md",
    "docs/REVISION_PROVIDERS.md",
    "docs/SIGNING_PROVIDERS.md",
    "docs/PLATFORM_ADAPTERS.md",
    "docs/AGENT_PROTOCOL_SUMMARY.md",
    "docs/EXECUTION_PROFILE_BENCHMARKS.md",
    "docs/REPOSITORY_INDEX.md",
    "docs/PERSISTENT_SEARCH_TRANSPORT.md",
    "docs/KNOWLEDGE_SOURCES.md",
    "scripts/generate-shell-completions.mjs",
    "scripts/generate-agent-protocol-summary.mjs",
    "scripts/run-execution-profile-benchmarks.mjs",
    "scripts/summarize-execution-profile-benchmarks.mjs",
    "scripts/validate-execution-profile-benchmarks.mjs",
    "scripts/report-execution-profile-outliers.mjs",
    "scripts/report-tail-interpretation.mjs",
    "scripts/verify-tgrep-manifest.mjs",
    "scripts/update-tgrep-manifest.mjs",
    "scripts/check-efficiency-regression.mjs",
    "scripts/lib/execution-profile-benchmark-io.mjs",
    "scripts/benchmark-cli-startup.mjs",
    "scripts/check-critical-coverage.mjs",
    "scripts/check-changelog-freshness.mjs",
    "scripts/write-forgeloop-attestation-summary.mjs",
    "completions",
    "integrations/generic-ci",
    "!src/core/gates.js",
    "!src/core/decision-classification.js",
    "!src/core/workflow-compatibility.js",
    "!src/core/cli-metadata.js"
  ],
  "scripts": {
    "test": "node scripts/run-tests.js",
    "pack:check": "node --test tests/package.test.js",
    "pack:smoke": "node scripts/package_smoke.mjs",
    "release:identity": "node scripts/verify_release_identity.mjs",
    "docs:diagrams": "node scripts/generate-documentation-diagrams.mjs",
    "docs:diagrams:check": "node scripts/check-documentation-diagrams.mjs",
    "docs:diagram:inventory": "node scripts/documentation-diagram-inventory.mjs --json",
    "docs:generate": "node scripts/generate_documentation_reference.mjs --write",
    "docs:generated:check": "node scripts/generate_documentation_reference.mjs --check",
    "docs:conformance": "node scripts/validate_documentation_conformance.mjs",
    "docs:examples:check": "node scripts/validate_documentation_examples.mjs",
    "docs:report": "node scripts/report_documentation_health.mjs",
    "docs:check": "node scripts/run-docs-check.js",
    "lint": "eslint .",
    "coverage": "c8 --all --include=src/**/*.js --reporter=text --reporter=lcov --reporter=json-summary --check-coverage --lines=80 --functions=75 --branches=70 --statements=80 node scripts/run-tests.js",
    "dependency:policy": "node scripts/check-dependency-policy.mjs",
    "mcp:test": "node scripts/run-mcp-tests.mjs",
    "completions:generate": "node scripts/generate-shell-completions.mjs --write",
    "completions:check": "node scripts/generate-shell-completions.mjs --check",
    "test:quick": "node --test tests/cli.test.js tests/schema-health.test.js tests/schema-golden.test.js tests/protocol-info.test.js tests/integration-capabilities.test.js",
    "performance:check": "node scripts/benchmark-cli-startup.mjs",
    "critical-coverage:check": "node scripts/check-critical-coverage.mjs",
    "changelog:check": "node scripts/check-changelog-freshness.mjs",
    "attestation:summary": "node scripts/write-forgeloop-attestation-summary.mjs",
    "summary:generate": "node scripts/generate-agent-protocol-summary.mjs --write",
    "summary:check": "node scripts/generate-agent-protocol-summary.mjs --check",
    "mcp:setup": "node scripts/mcp-setup.mjs",
    "mcp:pack:check": "node scripts/mcp-package-smoke.mjs",
    "poc:evidence:verify": "node scripts/verify_poc_evidence.mjs",
    "poc:evidence:test": "node --test poc/test/poc-evidence-publication.test.js",
    "benchmark:profiles": "node scripts/run-execution-profile-benchmarks.mjs",
    "benchmark:profiles:summary": "node scripts/summarize-execution-profile-benchmarks.mjs",
    "benchmark:profiles:check": "node scripts/validate-execution-profile-benchmarks.mjs",
    "benchmark:profiles:outliers": "node scripts/report-execution-profile-outliers.mjs",
    "benchmark:profiles:tail-analysis": "node scripts/report-tail-interpretation.mjs",
    "benchmark:profiles:regression": "node scripts/check-efficiency-regression.mjs",
    "transactions:compact": "node scripts/compact-transactions.mjs",
    "complexity:check": "node scripts/check-complexity.mjs",
    "task-discovery:benchmark": "node scripts/benchmark-task-discovery.mjs",
    "repository-index:manifest": "node scripts/verify-tgrep-manifest.mjs"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "smol-toml": "1.8.0"
  },
  "exports": {
    ".": "./src/cli.js",
    "./integration": {
      "types": "./src/integration.d.ts",
      "default": "./src/integration.js"
    }
  }
}
