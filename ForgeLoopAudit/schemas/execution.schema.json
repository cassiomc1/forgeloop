{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgeloop://schemas/execution.schema.json",
  "title": "ForgeLoop command execution artifact",
  "type": "object",
  "required": [
    "schemaVersion",
    "protocolVersion",
    "executionId",
    "taskId",
    "checkId",
    "requirement",
    "verificationCycle",
    "kind",
    "argv",
    "cwd",
    "resolution",
    "startedAt",
    "finishedAt",
    "status",
    "exitCode"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolVersion": { "const": 1 },
    "executionId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "checkId": { "type": "string", "minLength": 1 },
    "requirement": { "type": "string", "minLength": 1 },
    "verificationCycle": { "type": "integer", "minimum": 1 },
    "kind": { "const": "COMMAND_EXECUTION" },
    "executionKind": { "enum": ["VERIFICATION", "DURABLE_ACTION"] },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "protocolProjectRoot": { "type": "string", "minLength": 1 },
    "cwd": { "type": "string", "minLength": 1 },
    "executionIsolation": { "enum": ["NATIVE_PROJECT", "PROJECT_ISOLATED", "SYSTEM_ISOLATED"] },
    "isolation": {
      "type": "object",
      "required": ["mode", "isolated", "liveProjectWritable", "networkPolicy", "environmentPolicy"],
      "properties": {
        "mode": { "enum": ["NATIVE_PROJECT", "PROJECT_ISOLATED", "SYSTEM_ISOLATED"] },
        "isolated": { "type": "boolean" },
        "liveProjectWritable": { "type": "boolean" },
        "networkPolicy": { "type": "string", "minLength": 1 },
        "environmentPolicy": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": ["resolutionMode", "mayInstall", "installer", "tool"],
      "properties": {
        "resolutionMode": { "type": "string", "minLength": 1 },
        "mayInstall": { "type": "boolean" },
        "installer": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "tool": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "dispatch": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "scriptName": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "startedAt": { "type": "string", "minLength": 1 },
    "finishedAt": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "failed"] },
    "exitCode": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "durationMs": { "type": "integer", "minimum": 0 },
    "termination": { "enum": ["exit", "signal", "timeout", "spawn-error"] },
    "signal": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "stdoutSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stderrSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stdoutBytes": { "type": "integer", "minimum": 0 },
    "stderrBytes": { "type": "integer", "minimum": 0 },
    "outputTruncated": { "type": "boolean" }
    ,"timeoutMs": { "type": "integer", "minimum": 1 }
    ,"terminationGraceMs": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
