{
  "config": {
    "default": true,
    // MD013: operational lines, tables, and auditable URLs may be long.
    "MD013": false,
    // MD024: duplicate headings are accepted only in separate sections.
    "MD024": {
      "siblings_only": true
    },
    // MD033: the guides contain deliberate HTML examples.
    "MD033": false,
    // MD034: auditable lists preserve explicit URLs.
    "MD034": false,
    // MD036: existing editorial labels use emphasis instead of headings.
    "MD036": false,
    // MD040: some blocks reproduce content with no determinate language.
    "MD040": false
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    // Pinned third-party source stays byte-exact; security-skill:check verifies it.
    "skills/security-audit/**",
    "**/.worktrees/**",
    "**/.superpowers/**",
    "**/docs/superpowers/**",
    "**/node_modules/**",
    "**/coverage/**"
  ]
}
