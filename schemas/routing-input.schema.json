{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgeloop://schemas/routing-input.schema.json",
  "title": "ForgeLoop routing input",
  "type": "object",
  "required": ["schemaVersion", "workType", "surfaces", "risks", "platforms"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workType": { "type": "string", "minLength": 1 },
    "surfaces": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "platforms": { "type": "array", "items": { "type": "string" } },
    "behaviorChange": { "type": "boolean" },
    "executableChange": { "type": "boolean" },
    "projectEvidence": {
      "type": "object",
      "required": ["schemaVersion", "scope", "frameworks", "projectRoots", "primarySignals", "supportingSignals"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "scope": { "enum": ["MATCH", "UNSCOPED", "NO_MATCH", "NONE"] },
        "frameworks": { "type": "array", "items": { "enum": ["flutter", "dotnet", "aspnetcore", "abp", "nodejs", "rust", "c", "cpp", "java", "sql", "go", "typescript", "php", "swift"] } },
        "projectRoots": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "primarySignals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "supportingSignals": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
