  "summary": {
    "bound": false,
    "note": "Informational projection of the contract and receipt; only the statement and manifest are cryptographically bound.",
    "objective": "Add forgeloop evidence-publish: an explicit, opt-in command that uploads already-redacted evidence bundles from .forgeloop-evidence to the ForgeLoop evidence endpoint (default https://forgeloop.monster/api/evidence) authenticated by FORGELOOP_SYNC_TOKEN. Bundles to publish enter an offline queue kept outside the repository under the user config directory; every run retries the queue, removes published or unchanged items, keeps items on network or server errors, and drops items the remote rejects.",
    "successCriteria": [
      "evidence-publish uploads requested bundles, queues them offline when the remote is unreachable, and publishes the queue on a later run"
    ],
