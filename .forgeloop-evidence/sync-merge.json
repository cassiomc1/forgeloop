  "summary": {
    "bound": false,
    "note": "Informational projection of the contract and receipt; only the statement and manifest are cryptographically bound.",
    "objective": "Let sync-pull merge instead of only replacing: sync-pull --merge classifies every task of the local state and the remote snapshot three-way against per-task digests recorded at the last push or pull. Tasks changed on one side only, or present on one side only, are taken from that side; tasks changed on both sides are conflicts and the merge fails closed naming them. Without a recorded base only disjoint or identical tasks merge. The merged state is built offline from a local backup plus whole remote tasks copied row for row (the event chain is per task, so no history is rewritten), sealed with the canonical backup, verified, and activated through the same replace-active restore as sync-pull. --dry-run reports the classification without changing anything.",
    "successCriteria": [
      "sync-pull --merge combines tasks created on two machines into one verified state, and refuses tasks changed on both sides"
    ],
